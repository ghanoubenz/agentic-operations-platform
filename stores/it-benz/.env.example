# Copy to .env and change every value. Never commit .env.
DB_NAME=itbenz
DB_USER=itbenz
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
HTTP_PORT=8080
MAIL_UI_PORT=8025
SITE_URL=http://localhost:8080
ADMIN_USER=itbenz-admin
ADMIN_EMAIL=admin@example.com
# Leave empty to generate a random password (printed once by setup.sh)
ADMIN_PASSWORD=
WP_ENVIRONMENT_TYPE=staging
# Staging: Mailpit. Production: your mailbox provider's SMTP (see docs/05-deployment.md)
SMTP_HOST=mail
SMTP_PORT=1025
